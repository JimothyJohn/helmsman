<?xml version='1.0' encoding='utf-8'?>
<!-- Hand-written, not an editor export: the real Beremiz and OpenPLC
     example projects that have global variable lists (first_steps, python,
     Multi_Language, iec61131_lang_test, ...) all stop at an SFC body, a DT
     literal or a STRING first, so none of them compiles end to end yet.
     The <instances> block below is shaped like first_steps' in Beremiz
     (a constant <globalVars> on the configuration, a <globalVars> and a
     task with its program instance on the resource), and the
     <externalVars> like the ones in OpenPLC's Arduino examples. -->
<project xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="tcpethernet" productName="globals" productVersion="1" creationDateTime="2026-11-15T09:00:00"/>
  <contentHeader name="globals" modificationDateTime="2026-11-15T09:00:00">
    <coordinateInfo>
      <fbd><scaling x="0" y="0"/></fbd>
      <ld><scaling x="0" y="0"/></ld>
      <sfc><scaling x="0" y="0"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Bump" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="amount"><type><DINT/></type></variable>
          </inputVars>
          <externalVars>
            <variable name="ResourceGlobal"><type><DINT/></type></variable>
          </externalVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[ResourceGlobal := ResourceGlobal + amount;]]></xhtml:p>
          </ST>
        </body>
      </pou>
      <pou name="plc_prg" pouType="program">
        <interface>
          <localVars>
            <variable name="b"><type><derived name="Bump"/></type></variable>
            <variable name="seen"><type><DINT/></type></variable>
            <variable name="limit_seen"><type><INT/></type></variable>
          </localVars>
          <externalVars constant="true">
            <variable name="ResetCounterValue"><type><INT/></type></variable>
          </externalVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[b(amount := 3);
seen := ResourceGlobal;
limit_seen := ResetCounterValue;
Hits := Hits + 1;]]></xhtml:p>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="config">
        <resource name="resource1">
          <task name="task0" priority="0" interval="T#20ms">
            <pouInstance name="instance0" typeName="plc_prg"/>
          </task>
          <globalVars>
            <variable name="ResourceGlobal">
              <type><DINT/></type>
              <initialValue>
                <simpleValue value="2"/>
              </initialValue>
            </variable>
          </globalVars>
        </resource>
        <globalVars constant="true">
          <variable name="ResetCounterValue">
            <type><INT/></type>
            <initialValue>
              <simpleValue value="17"/>
            </initialValue>
          </variable>
        </globalVars>
        <globalVars retain="true">
          <variable name="Hits"><type><DINT/></type></variable>
        </globalVars>
      </configuration>
    </configurations>
  </instances>
</project>
