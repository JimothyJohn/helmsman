<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="33.00" TargetName="Bench" TargetType="Controller" ContainsContext="false" ExportOptions="NoRawData L5KData DecoratedData">
<Controller Use="Target" Name="Bench" ProcessorType="5069-L310ER" MajorRev="33" MinorRev="0">
<Tags>
<Tag Name="Run_Lamp" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="Parts" TagType="Base" DataType="COUNTER" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated">
<Structure DataType="COUNTER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="3"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="CU" DataType="BOOL" Value="0"/>
<DataValueMember Name="CD" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
<DataValueMember Name="OV" DataType="BOOL" Value="0"/>
<DataValueMember Name="UN" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
<Tag Name="Speeds" TagType="Base" DataType="REAL" Dimensions="4" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated">
<Array DataType="REAL" Dimensions="4" Radix="Float">
<Element Index="[0]" Value="1.5"/>
<Element Index="[1]" Value="2.5"/>
<Element Index="[2]" Value="0.0"/>
<Element Index="[3]" Value="-4.25"/>
</Array>
</Data>
</Tag>
<Tag Name="Lamp" TagType="Alias" Radix="Decimal" AliasFor="Run_Lamp" ExternalAccess="Read/Write"/>
<Tag Name="Gain" TagType="Base" DataType="DINT" Radix="Decimal" Constant="true" ExternalAccess="Read Only">
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="7"/>
</Data>
</Tag>
</Tags>
<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags>
<Tag Name="Start" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Stop" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Part_Eye" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Motor" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Running" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Delay" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Eye_Ons" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Total" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Avg" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Status" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Log" TagType="Base" DataType="DINT" Dimensions="5" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Seal-in start/stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Start),XIC(Running)]XIO(Stop)OTE(Running);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Running)TON(Delay,2000,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Delay.DN)OTE(Motor)OTE(Lamp);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Part_Eye)ONS(Eye_Ons)CTU(Parts,?,?)ADD(Total,1,Total);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Parts.DN)RES(Parts)JSR(Stats,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Stats" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CPT(Avg,(Speeds[0] + Speeds[1] + Speeds[3]) / 3.0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[COP(Log[0],Log[1],4)MOV(Total,Log[0])MUL(Total,Gain,Status);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LIM(10,Total,20)OTL(Status.15);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="PERIODIC" Rate="10" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
