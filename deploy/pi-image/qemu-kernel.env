# The kernel scripts/box-boot-test.sh boots the image's root filesystem with
# under QEMU's generic `virt` machine (docs/BOX.md, "In CI"): Debian
# trixie's cloud flavour for arm64, taken from deb.debian.org and checked by
# SHA-256. The cloud flavour is the small one built for virtual machines;
# it has NVMe built in (the disk) but virtio-net as a module, so the script
# copies this package's /lib/modules into the CI copy of the image.
#
# Bump: take the new Filename and SHA256 of `linux-image-*-cloud-arm64` from
#   https://deb.debian.org/debian/dists/trixie/main/binary-arm64/Packages.xz
# Debian drops a superseded version from the pool, so a 404 here means this
# pin is old, not that the script broke.
KERNEL_VERSION=6.12.107+deb13-cloud-arm64
KERNEL_URL=https://deb.debian.org/debian/pool/main/l/linux-signed-arm64/linux-image-6.12.107+deb13-cloud-arm64_6.12.107-1_arm64.deb
KERNEL_SHA256=a1bbfc22454e984feba6353f957152ef416728b627ec0cf94d3ac04b18c14d84
