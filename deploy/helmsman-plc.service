# helmsman-plc: IEC 61131-3 programs behind the CIP adapter.
# Installed by scripts/pi-deploy-plc.sh, which writes /etc/helmsman-plc/env
# and the canvas (the browser editor) to /usr/local/share/helmsman-plc/ui
# (PLC_UI). PLC_SOURCE is `--projects` (the editor's projects in the state
# directory, the deployed one booted from its store) or, in the old mode,
# one program file under /etc/helmsman-plc/. PLC_SEED (`NAME FILE.st`, or
# empty) seeds a first install with a deployed project: `project seed`
# acts only while there is no project and nothing deployed; if it fails
# (a seed that does not build) the box starts anyway, running nothing, and
# the journal says why. PLC_RELAY_ARGS is empty, or `--relay URL
# --relay-token /run/credentials/helmsman-plc.service/relay-token
# [--box-name NAME]` as helmsman-firstboot writes it (docs/BOX.md): the
# token file /etc/helmsman-plc/relay-token (root, 0600, empty until
# paired) reaches the service as a credential, never as an environment
# variable.
[Unit]
Description=Helmsman soft PLC (IEC 61131-3, CIP adapter on 44818/2222)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/helmsman-plc/env
ExecStartPre=-/usr/local/bin/helmsman-plc project seed --scan-ms ${PLC_SCAN_MS} $PLC_SEED
ExecStart=/usr/local/bin/helmsman-plc ${PLC_SOURCE} --scan-ms ${PLC_SCAN_MS} --api ${PLC_API} --ui ${PLC_UI} $PLC_RELAY_ARGS
LoadCredential=relay-token:/etc/helmsman-plc/relay-token
DynamicUser=yes
# The box API's token (api-token, 0600) lives here: /var/lib/helmsman-plc,
# writable under ProtectSystem=strict and passed in as $STATE_DIRECTORY.
# The API, and the canvas at /, listen on PLC_API: 127.0.0.1:8080 unless
# the deploy was asked for the LAN (PLC_API=0.0.0.0:8080, which also opens
# the port in the firewall). First start prints the token
# once: journalctl -u helmsman-plc | grep 'API token'.
StateDirectory=helmsman-plc
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
# Ports are all >1024: no capabilities needed.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Scan timing: ahead of ordinary processes, never real-time.
Nice=-5

[Install]
WantedBy=multi-user.target
